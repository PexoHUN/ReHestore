{
  "manifest_version": 3,
  "name": "ReHestore",
  "version": "0.5.0",
  "description": "Modern, letisztult felület a hestore.hu webáruházhoz.",
  "permissions": ["storage", "activeTab"],
  "action": {
    "default_popup": "src/popup.html",
    "default_title": "ReHestore",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.hestore.hu/*",
        "https://hestore.hu/*"
      ],
      "js": ["src/content.js"],
      "css": ["src/content.css"],
      "run_at": "document_start"
    }
  ]
}
